# Copy to .env and fill in. Every value can also be passed as a real environment variable.

# Public base URL of this server as users reach it from the internet (no trailing slash). Required.
PUBLIC_URL=https://snore.yourdomain.com

# Hostname only, used by docker compose for Caddy's automatic TLS. Must match PUBLIC_URL.
SNORE_DOMAIN=snore.yourdomain.com

# Discord application used for "Login with Discord".
# Create one at https://discord.com/developers/applications, then under OAuth2 add
#   <PUBLIC_URL>/v1/oauth/callback
# as a redirect. Scope needed: identify.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where the SQLite database (and an optional plugins.json override) live.
DATA_DIR=./data

# Bind address and port. Docker compose overrides HOST to 0.0.0.0 inside the container.
# For a bare metal install behind Caddy/nginx keep 127.0.0.1.
HOST=127.0.0.1
PORT=8080

# Set to 1 when running behind a reverse proxy so rate limiting sees real client IPs.
TRUST_PROXY=1

# Optional: comma separated Discord user ids. When set, only these accounts may connect.
ALLOWED_USER_IDS=

# Optional: where /download and /plugins pull releases and plugin lists from.
GITHUB_REPO=aababababababbabaabababababba/SnoreClient

# Optional: branding and limits.
SITE_NAME=SnoreClient
MAX_BLOB_BYTES=8388608
MAX_KEYS_PER_USER=64
RATE_LIMIT_PER_MINUTE=120
# DISCORD_INVITE=https://discord.gg/yourserver
