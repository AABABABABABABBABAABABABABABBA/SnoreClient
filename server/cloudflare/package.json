{
    "name": "snoreclient-cloudflare",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "db:create": "wrangler d1 create snoreclient",
        "db:migrate": "wrangler d1 execute snoreclient --remote --file=schema.sql",
        "db:migrate:local": "wrangler d1 execute snoreclient --local --file=schema.sql",
        "secret": "wrangler secret put DISCORD_CLIENT_SECRET",
        "test": "node --test test/*.test.js"
    },
    "devDependencies": {
        "wrangler": "^4"
    }
}
